{
  "manifest_version": 3,
  "name": "Optimus Capture",
  "description": "Capture produtos abertos no navegador e gere preview no Optimus Promo.",
  "version": "0.1.0",
  "action": {
    "default_title": "Optimus Capture"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://go.optimuspromo.com.br/*",
    "https://*.mercadolivre.com.br/*",
    "https://*.mercadolibre.com/*",
    "https://shopee.com.br/*",
    "https://www.shopee.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.mercadolivre.com.br/*",
        "https://*.mercadolibre.com/*",
        "https://shopee.com.br/*",
        "https://www.shopee.com.br/*"
      ],
      "js": [
        "core/product-contract.js",
        "core/marketplace-detector.js",
        "adapters/mercadolivre.js",
        "adapters/shopee.js",
        "adapters/registry.js",
        "content/capture-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
