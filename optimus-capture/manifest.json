{
  "manifest_version": 3,
  "name": "Optimus Capture",
  "description": "Capture produtos abertos no navegador e gere preview no Optimus Promo.",
  "version": "0.1.0",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Optimus Capture",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://go.optimuspromo.com.br/*",
    "https://*.mercadolivre.com.br/*",
    "https://*.mercadolibre.com/*",
    "https://amazon.com.br/*",
    "https://www.amazon.com.br/*",
    "https://shopee.com.br/*",
    "https://www.shopee.com.br/*",
    "https://aliexpress.com/*",
    "https://*.aliexpress.com/*",
    "https://kabum.com.br/*",
    "https://www.kabum.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.mercadolivre.com.br/*",
        "https://*.mercadolibre.com/*",
        "https://amazon.com.br/*",
        "https://www.amazon.com.br/*",
        "https://shopee.com.br/*",
        "https://www.shopee.com.br/*",
        "https://aliexpress.com/*",
        "https://*.aliexpress.com/*",
        "https://kabum.com.br/*",
        "https://www.kabum.com.br/*"
      ],
      "js": [
        "core/product-contract.js",
        "core/marketplace-detector.js",
        "adapters/mercadolivre.js",
        "adapters/amazon.js",
        "adapters/shopee.js",
        "adapters/aliexpress.js",
        "adapters/kabum.js",
        "adapters/registry.js",
        "content/capture-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
